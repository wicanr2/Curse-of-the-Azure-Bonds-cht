  "locales": {
    "en": {
      "pit.departure.alias_alive": "Alias thanks the party and leaves. The scent of honeysuckle fills the air as Dragonbait bows and follows her.",
      "pit.departure.alias_dead": "Dragonbait carries Alias's body toward Hillsfar.",
      "zhentil.patrol_pass": "A Zhentil Keep patrol notices the sigils on the party's arms and lets them pass.",
      "zhentil.edge": "You are at the edge of Zhentil Keep. Will you enter or continue your journey?",
      "zhentil.guards_question": "The guards take the party aside for questioning and record Journal Entry 32.",
      "zhentil.guards_warning": "A guard says the party matches the little thief's description; the commander says they will get theirs inside.",
      "zhentil.inner_city": "You join the teeming masses of the inner city.",
      "journal.32": "Journal Entry 32: Two guards and their commander compile a detailed file on the party and insist that it is strictly routine."
      ,"world.tilverton": "Tilverton"
      ,"world.shadowdale": "Shadowdale"
      ,"world.ashabenford": "Ashabenford"
      ,"world.dagger-falls": "Dagger Falls"
      ,"world.standing-stone": "The Standing Stone"
      ,"world.voonlar": "Voonlar"
      ,"world.phlan": "Phlan"
