  "text_rules": [
    {
      "id": "zhentil.patrol_pass",
      "all_contains": [
        "YOU ARE CONFRONTED BY A PATROL FROM ZHENTIL KEEP",
        "NOTING THE SIGILS ON YOUR ARMS",
        "THEY LET YOU PASS"
