+#if !defined(CPUCORE_IA32)
+static void coab_direct_v30_probe(void) {
+	const char *path;
+	FILE *source;
+	size_t size;
+
+	path = getenv("COAB_V30_PROBE");
+	if ((path == NULL) || (path[0] == '\0')) {
+		return;
+	}
+	source = fopen(path, "rb");
+	if (source == NULL) {
+		fprintf(stderr, "COAB_V30_PROBE open failed: %s\n", path);
+		exit(2);
+	}
+	size = fread(mem + 0x1fe00, 1, 1024, source);
+	fclose(source);
+	if (size != 1024) {
+		fprintf(stderr, "COAB_V30_PROBE size=%zu, want 1024\n", size);
+		exit(2);
+	}
+
+	CPU_CS = 0x1fe0;
+	CPU_IP = 0x0000;
+	CPU_DS = 0x1fe0;
+	CPU_SS = 0x1fe0;
+	CPU_SP = 0x03f0;
+	CS_BASE = 0x1fe00;
+	DS_BASE = 0x1fe00;
+	SS_BASE = 0x1fe00;
+	CPU_FLAG = 0x0202;
+	fprintf(stderr,
+			"COAB_V30_PROBE injected cs:ip=%04x:%04x size=%zu\n",
+			CPU_CS, CPU_IP, size);
+	fflush(stderr);
+}
+#endif
